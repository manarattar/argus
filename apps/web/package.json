{
  "name": "@argus/web",
  "version": "0.1.0",
  "private": true,
  "description": "ARGUS analyst workspace",
  "scripts": {
    "dev": "node scripts/next.mjs dev -p 3000",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start -p 3000",
    "lint": "node scripts/next.mjs lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "14.2.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.21",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
