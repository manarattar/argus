# ARGUS configuration
#
# Copy to .env and edit. Every value below has a working default, so the
# application runs on a fresh clone with no changes: SQLite, the local lexical
# embedder, and Demo Mode serving recorded model responses.
#
# Never commit .env. It is git-ignored.

# ---------------------------------------------------------------------------
# Model backend
# ---------------------------------------------------------------------------
# auto      resolve to live inference when a token is set, replay otherwise
# openai    force the OpenAI-compatible backend
# anthropic force the Anthropic backend
# replay    force Demo Mode even when a token is available
MODEL_BACKEND=auto

# Set exactly one of these to run live inference. Leave both empty for Demo Mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Point OPENAI_BASE_URL at any OpenAI-compatible gateway to use it instead.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=4096
# Attempts per agent step, including the first, before the step fails.
MODEL_MAX_ATTEMPTS=3

# Capture live model exchanges into data/recordings so Demo Mode can serve
# them later. Turn on only when deliberately refreshing the demo fixtures.
RECORD_LLM_CALLS=false

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# auto uses OPENAI_API_KEY when present, and the local lexical vectoriser
# otherwise. The local vectoriser needs no network and no account; it matches on
# term overlap rather than meaning, and the UI says so.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite by default so first run needs no container.
# docker compose sets this to the Postgres + pgvector service instead:
# DATABASE_URL=postgresql+psycopg://argus:argus@db:5432/argus
#
# Leave blank to use the local SQLite default.
DATABASE_URL=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
ENVIRONMENT=local
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_SUFFIXES=.txt,.md

# ---------------------------------------------------------------------------
# Frontend (apps/web reads this at build and run time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
